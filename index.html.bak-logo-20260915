  <style>
    :root{
      --bg:#0b0e0f;
      --bg-deep:#070909;
      --panel:#111617;
      --panel-2:#161b1c;
      --ink:#f3f0ea;
      --muted:#a7aaa7;
      --paper:#f0ede7;
      --paper-2:#e4e0d8;
      --ink-dark:#131718;
      --muted-dark:#535754;
      --line:rgba(255,255,255,.15);
      --line-dark:rgba(19,23,24,.18);
      --accent:#e43128;
      --accent-dark:#ae201b;
      --max:1280px;
      --shadow:0 32px 90px rgba(0,0,0,.32);
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:var(--bg);color:var(--ink);font-family:"Inter",Arial,sans-serif;line-height:1.5;overflow-x:hidden}
    body.menu-open{overflow:hidden}
    a{color:inherit;text-decoration:none}
    button,input,textarea{font:inherit}
    img{display:block;max-width:100%}
    section{position:relative}
    .shell{width:min(calc(100% - 72px),var(--max));margin-inline:auto}
    .eyebrow{color:var(--accent);font:600 .68rem/1.2 "IBM Plex Mono",monospace;letter-spacing:.2em;text-transform:uppercase}
    .mono{font-family:"IBM Plex Mono",monospace;letter-spacing:.08em;text-transform:uppercase}
    .display{font-family:"Barlow Condensed","Arial Narrow",sans-serif;font-weight:500;letter-spacing:-.035em;line-height:.88;text-transform:uppercase}
    .desktop-break{display:block}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:.82rem;min-height:50px;padding:0 1.25rem;border:1px solid rgba(255,255,255,.38);background:transparent;color:var(--ink);font-size:.7rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;transition:transform .25s ease,background .25s ease,border-color .25s ease,color .25s ease}
    .btn:hover{transform:translateY(-2px);border-color:var(--ink)}
    .btn:focus-visible,.nav a:focus-visible,.brand:focus-visible,.menu-toggle:focus-visible{outline:2px solid var(--accent);outline-offset:4px}
    .btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}
    .btn.primary:hover{background:#f0443a;border-color:#f0443a}
    .arrow{font-size:1.05rem;line-height:0}

    /* Header */
    .nav{position:absolute;inset:0 0 auto;z-index:20;border-bottom:1px solid transparent;transition:background .3s ease,border-color .3s ease,backdrop-filter .3s ease}
    .nav.scrolled{position:fixed;background:rgba(7,9,10,.88);border-color:var(--line);backdrop-filter:blur(16px)}
    .nav-inner{height:88px;display:grid;grid-template-columns:220px minmax(0,1fr) auto;align-items:center;gap:2.3rem}
    .brand{display:flex;align-items:center;gap:.72rem;min-width:0}
    .brand-mark{width:32px;height:42px;flex:0 0 auto;filter:drop-shadow(0 0 16px rgba(228,49,40,.22))}
    .brand-mark svg{width:100%;height:100%}
    .brand-title{font:600 1.45rem/.82 "Barlow Condensed",sans-serif;letter-spacing:.04em;text-transform:uppercase}
    .brand-title small{display:block;margin-top:.38rem;color:#c8cbc7;font:500 .49rem/1 "IBM Plex Mono",monospace;letter-spacing:.28em}
    .menu{display:flex;justify-content:center;gap:1.55rem;font-size:.6rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#d7d8d5}
    .menu a{position:relative;padding:.6rem 0}
    .menu a::after{content:"";position:absolute;right:100%;bottom:0;left:0;height:1px;background:var(--accent);transition:right .2s ease}
    .menu a:hover::after,.menu a[aria-current="page"]::after{right:0}
    .hotline{display:flex;align-items:center;gap:.75rem;border-left:1px solid var(--line);padding-left:1rem}
    .hotline-badge{display:grid;place-items:center;min-width:42px;min-height:42px;background:var(--accent);font:400 1.55rem/.9 "Barlow Condensed",sans-serif}
    .hotline-copy{color:#bfc2bf;font:500 .53rem/1.4 "IBM Plex Mono",monospace;letter-spacing:.08em;text-transform:uppercase}
    .hotline-copy b{display:block;margin-top:.15rem;color:#fff;font:500 .68rem/1.1 "Inter",sans-serif;letter-spacing:0}
    .menu-toggle{display:none;align-items:center;justify-content:center;width:42px;height:42px;border:1px solid var(--line);background:transparent;color:var(--ink);cursor:pointer}
    .menu-toggle svg{width:18px}

    /* Hero */
    .hero{isolation:isolate;min-height:clamp(560px,55vw,760px);overflow:hidden;background:#090b0c}
    .hero-media,.hero-overlay,.hero-grid,.hero-aside{position:absolute}
    .hero-media{inset:0;z-index:-3}
    .hero-media img{width:100%;height:100%;object-fit:cover;object-position:center}
    .hero-overlay{inset:0;z-index:-2;background:
      linear-gradient(90deg,rgba(6,8,9,.98) 0%,rgba(6,8,9,.9) 27%,rgba(6,8,9,.26) 62%,rgba(6,8,9,.55) 100%),
      linear-gradient(0deg,rgba(6,8,9,.82) 0%,transparent 36%,rgba(6,8,9,.28) 100%)}
    .hero::after{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;opacity:.28;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:48px 48px;mask-image:linear-gradient(to right,transparent,#000 45%,#000)}
    .hero-grid{inset:0;width:min(calc(100% - 72px),var(--max));margin-inline:auto;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);align-items:end;padding-top:88px}
    .hero-copy{align-self:end;max-width:660px;padding:0 0 4.1rem}
    .hero h1{margin:.9rem 0 1.35rem;font-size:clamp(3.6rem,5.8vw,6.2rem);max-width:660px}
    .hero-lead{max-width:470px;margin:0 0 1.7rem;color:#d0d2ce;font-size:.88rem;line-height:1.55}
    .hero-actions{display:flex;flex-wrap:wrap;gap:.7rem}
    .hero-meta{display:flex;align-items:center;gap:.7rem;margin-top:2.25rem;color:#b9bdb9;font:500 .54rem/1.7 "IBM Plex Mono",monospace;letter-spacing:.13em;text-transform:uppercase}
    .pin{display:grid;place-items:center;width:24px;height:24px;border:1px solid rgba(255,255,255,.33);border-radius:50%;font-size:.9rem}
    .hero-aside{right:22px;top:50%;z-index:2;color:#d0d2ce;font:500 .55rem/2.05 "IBM Plex Mono",monospace;letter-spacing:.3em;text-transform:uppercase;writing-mode:vertical-rl;transform:translateY(-50%)}

    /* Trust band */
    .trust{z-index:3;background:var(--paper);color:var(--ink-dark);border-top:1px solid rgba(255,255,255,.8)}
    .trust-grid{display:grid;grid-template-columns:1.05fr .88fr 1.08fr 1.45fr .95fr}
    .trust-item{display:flex;min-height:116px;flex-direction:column;justify-content:center;padding:1.45rem 1.45rem;border-right:1px solid var(--line-dark)}
    .trust-item:last-child{border-right:0}
    .trust-item b{font:600 2.15rem/.86 "Barlow Condensed",sans-serif;letter-spacing:.01em;text-transform:uppercase}
    .trust-item small{margin-top:.52rem;color:#4b4f4d;font:600 .55rem/1.45 "IBM Plex Mono",monospace;letter-spacing:.09em;text-transform:uppercase}
    .trust-item:first-child small,.trust-item:last-child small{max-width:130px;font-size:.52rem;letter-spacing:.15em}

    /* Services */
    .section-paper{background:var(--paper);color:var(--ink-dark);padding:3.65rem 0 0}
    .section-head{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(250px,.75fr);gap:2.4rem;align-items:end;margin-bottom:2rem}
    .section-head h2{margin:.55rem 0 0;font-size:clamp(3.4rem,5.2vw,5.9rem)}
    .section-head p{max-width:430px;margin:0 0 .25rem;color:var(--muted-dark);font-size:.82rem;line-height:1.65}
    .services-layout{display:grid;grid-template-columns:minmax(0,1fr) 164px}
    .services-main{min-width:0}
    .cap-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid var(--line-dark)}
    .cap-card{display:flex;min-height:198px;flex-direction:column;padding:1rem 1.05rem 1.2rem;border-right:1px solid var(--line-dark)}
    .cap-card:last-child{border-right:0}
    .cap-no{color:#828783;font:500 .62rem/1 "IBM Plex Mono",monospace;letter-spacing:.16em}
    .cap-icon{display:grid;place-items:center;width:40px;height:40px;margin:1.2rem 0 1rem;border:1px solid rgba(228,49,40,.55);color:var(--accent)}
    .cap-icon svg{width:20px;height:20px}
    .cap-card h3{margin:0 0 .7rem;font:600 1.55rem/.9 "Barlow Condensed",sans-serif;letter-spacing:.01em;text-transform:uppercase}
    .cap-card p{max-width:180px;margin:0;color:#515653;font-size:.7rem;line-height:1.48}
    .cap-card a{margin-top:auto;color:var(--accent);font-size:1.55rem;transition:transform .2s ease}
    .cap-card a:hover{transform:translateX(4px)}
    .service-aside{position:relative;min-height:198px;overflow:hidden;border-left:7px solid var(--paper);background:var(--bg)}
    .service-aside img{width:100%;height:100%;object-fit:cover;object-position:center}
    .service-aside::after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(4,6,7,.94),rgba(4,6,7,.08) 70%)}
    .service-aside h3{position:absolute;right:1rem;bottom:1.25rem;left:1rem;z-index:1;margin:0;color:#fff;font:500 2rem/.9 "Barlow Condensed",sans-serif;text-transform:uppercase}

    /* FM-200 */
    .section-dark{background:var(--bg);padding:0}
    .fm-wrap{display:grid;grid-template-columns:minmax(190px,.84fr) minmax(280px,1.22fr) minmax(240px,1fr);min-height:480px;border-inline:1px solid var(--line)}
    .fm-check{padding:2.8rem 2rem;border-right:1px solid var(--line);background:#0c1011}
    .fm-check h3{margin:0 0 1.65rem;color:#c4c7c3;font:500 .63rem/1.2 "IBM Plex Mono",monospace;letter-spacing:.22em;text-transform:uppercase}
    .check-item{display:flex;gap:.65rem;padding:.63rem 0;border-bottom:1px solid rgba(255,255,255,.09);color:#aeb2ae;font:500 .56rem/1.35 "IBM Plex Mono",monospace;letter-spacing:.06em;text-transform:uppercase}
    .check-item::before{content:"◇";color:var(--accent);font-size:.75rem}
    .fm-media{position:relative;height:480px;min-height:0;overflow:hidden;background:#101516}
    .fm-media img{width:100%;height:100%;object-fit:cover;object-position:center}
    .fm-media::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(6,8,9,.16),transparent 40%,rgba(6,8,9,.2))}
    .fm-label{position:absolute;right:15%;bottom:18%;left:15%;z-index:1;padding:.72rem .45rem;border:3px solid #aaa9a1;background:#dedbd2;color:#101313;text-align:center;font:700 1.15rem/.9 "Barlow Condensed",sans-serif;letter-spacing:.02em;text-transform:uppercase}
    .fm-label small{display:block;margin-top:.35rem;font:600 .45rem/1 "IBM Plex Mono",monospace;letter-spacing:.09em}
    .fm-copy{display:flex;flex-direction:column;justify-content:center;padding:3.1rem 2.65rem;background:#101415}
    .fm-copy h2{margin:.4rem 0 1rem;color:#f5f2ec;font-size:clamp(4rem,6.2vw,7rem)}
    .fm-copy h4{max-width:260px;margin:0 0 1.1rem;color:#f1eee8;font:600 1rem/1.05 "Barlow Condensed",sans-serif;letter-spacing:.05em;text-transform:uppercase}
    .fm-copy p{max-width:360px;margin:0;color:#b6bab6;font-size:.78rem;line-height:1.65}
    .text-link{display:inline-flex;align-items:center;gap:.75rem;margin-top:1.45rem;color:#fff;font:700 .59rem/1.2 "IBM Plex Mono",monospace;letter-spacing:.08em;text-transform:uppercase}

    /* Field gallery */
    .field{background:var(--paper);color:var(--ink-dark)}
    .field-grid{display:grid;grid-template-columns:1.32fr repeat(4,1fr) .9fr;min-height:260px}
    .field-copy{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:2.5rem 1.45rem 2.5rem 0}
    .field-copy h2{max-width:190px;margin:.55rem 0 .8rem;font-size:clamp(2.5rem,4vw,4.1rem)}
    .field-copy p{max-width:205px;margin:0;color:#535754;font-size:.72rem;line-height:1.5}
    .field-copy a{margin-top:1.35rem;color:var(--accent);font:700 .58rem/1.2 "IBM Plex Mono",monospace;letter-spacing:.07em;text-transform:uppercase}
    .field-photo{position:relative;height:260px;min-height:0;overflow:hidden;border-left:7px solid var(--paper)}
    .field-photo img{width:100%;height:100%;object-fit:cover;transition:transform .6s ease,filter .6s ease}
    .field-photo:hover img{transform:scale(1.05);filter:saturate(1.12)}
    .field-note{display:flex;align-items:flex-end;padding:1.25rem .9rem;height:260px;min-height:0;border-left:7px solid var(--paper);background:var(--bg);color:#e6e3dc}
    .field-note p{margin:0;font:500 .59rem/1.9 "IBM Plex Mono",monospace;letter-spacing:.2em;text-transform:uppercase}

    /* Compliance */
    .compliance{background:var(--panel);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
    .compliance-grid{display:grid;grid-template-columns:minmax(300px,.95fr) minmax(0,1.35fr);min-height:360px}
    .architecture{position:relative;min-height:360px;overflow:hidden;border-right:1px solid var(--line);background:#0d1112}
    .architecture img{width:100%;height:100%;object-fit:cover;object-position:center}
    .architecture::after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(5,7,8,.8),transparent 60%),linear-gradient(90deg,rgba(5,7,8,.35),transparent)}
    .architecture-note{position:absolute;bottom:2rem;left:2rem;z-index:1;max-width:180px;color:#bfc2be;font:500 .56rem/1.9 "IBM Plex Mono",monospace;letter-spacing:.19em;text-transform:uppercase}
    .compliance-copy{padding:4rem 3.6rem}
    .compliance-copy h2{margin:.55rem 0 1.1rem;font-size:clamp(3rem,4.6vw,5.4rem)}
    .compliance-copy>p{max-width:600px;margin:0;color:#b9bdb9;font-size:.78rem;line-height:1.65}
    .proofs{display:grid;grid-template-columns:repeat(3,1fr);margin-top:2.7rem;border-top:1px solid var(--line)}
    .proof{min-height:130px;padding:1.35rem 1rem 0 0;border-right:1px solid var(--line)}
    .proof+.proof{padding-left:1rem}
    .proof:last-child{border-right:0}
    .proof-icon{margin-bottom:.75rem;color:var(--accent)}
    .proof-icon svg{width:20px;height:20px}
    .proof b{display:block;color:#f1eee8;font:600 1.2rem/1 "Barlow Condensed",sans-serif;letter-spacing:.02em;text-transform:uppercase}
    .proof small{display:block;margin-top:.45rem;color:#949995;font:500 .52rem/1.45 "IBM Plex Mono",monospace;letter-spacing:.07em;text-transform:uppercase}

    /* CTA and footer */
    .cta{padding:2.5rem 0;background:#101415;border-bottom:1px solid var(--line)}
    .cta-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:3.8rem;align-items:center}
    .cta h2{max-width:650px;margin:.55rem 0 0;font-size:clamp(3.4rem,5.4vw,6rem)}
    .cta-right p{max-width:510px;margin:0 0 1.35rem;color:#b7bab7;font-size:.78rem;line-height:1.65}
    .cta-actions{display:flex;flex-wrap:wrap;gap:.65rem}
    footer{padding:2.2rem 0 1rem;background:var(--bg-deep)}
    .footer-grid{display:grid;grid-template-columns:1.25fr .82fr .95fr 1.25fr;gap:2.3rem;padding-bottom:2.35rem;border-bottom:1px solid var(--line)}
    .footer-brand p{max-width:230px;margin:.9rem 0 0;color:#888d89;font:500 .56rem/1.65 "IBM Plex Mono",monospace;letter-spacing:.13em;text-transform:uppercase}
    .footer-col h4{margin:0 0 .95rem;color:#777c78;font:600 .57rem/1.2 "IBM Plex Mono",monospace;letter-spacing:.15em;text-transform:uppercase}
    .footer-col a,.footer-col p{display:block;margin:.5rem 0;color:#c4c7c4;font-size:.67rem}
    .footer-contact{display:flex;align-items:flex-start;gap:.8rem}
    .footer-contact svg{flex:0 0 auto;width:25px;height:25px;color:var(--accent)}
    .footer-contact strong{display:block;color:#f0ede7;font-size:.76rem}
    .footer-contact small{display:block;margin-top:.25rem;color:#8e938f;font:500 .51rem/1.5 "IBM Plex Mono",monospace;letter-spacing:.08em;text-transform:uppercase}
    .social-mark{display:inline-grid;place-items:center;width:25px;height:25px;margin-top:.95rem;border:1px solid rgba(255,255,255,.35);border-radius:4px;color:#e9e6df;font-weight:800;font-size:.75rem}
    .foot-bottom{display:flex;justify-content:space-between;gap:1rem;padding-top:1.1rem;color:#6f7470;font:500 .5rem/1.4 "IBM Plex Mono",monospace;letter-spacing:.08em;text-transform:uppercase}

    /* Responsive */
    @media (max-width:1080px){
      .shell{width:min(calc(100% - 48px),var(--max))}
      .nav-inner{grid-template-columns:190px minmax(0,1fr) auto;gap:1.3rem}
      .menu{gap:1rem}
      .hero-grid{width:min(calc(100% - 48px),var(--max))}
      .hero h1{font-size:clamp(3.7rem,6.5vw,5.8rem)}
      .section-head{gap:1.8rem;margin-bottom:1.55rem}
      .section-head h2{font-size:clamp(3.1rem,5vw,5.1rem)}
      .section-paper{padding-top:3rem}
      .services-layout{grid-template-columns:minmax(0,1fr) 138px}
      .cap-card{padding-inline:.9rem}
      .service-aside h3{font-size:1.65rem}
      .cap-card,.service-aside{min-height:174px}
      .fm-wrap{min-height:390px}
      .fm-media{height:390px}
      .fm-copy{padding-inline:1.65rem}
      .field-grid{grid-template-columns:1.2fr repeat(4,1fr) .78fr;min-height:220px}
      .field-photo,.field-note{height:220px;min-height:0}
      .field-copy{padding-right:1rem}
      .compliance-grid,.architecture{min-height:320px}
      .compliance-copy{padding:2.8rem 2.5rem}
      .cta{padding:2rem 0}
      footer{padding-top:1.8rem}
    }
    @media (max-width:800px){
      html{scroll-behavior:auto}
      .shell{width:min(calc(100% - 28px),var(--max))}
      .nav-inner{height:74px;grid-template-columns:minmax(0,1fr) auto auto}
      .brand-title{font-size:1.28rem}
      .menu{position:absolute;top:74px;right:14px;left:14px;display:flex;flex-direction:column;gap:0;padding:.65rem 1.1rem;background:rgba(7,9,10,.97);border:1px solid var(--line);box-shadow:var(--shadow);opacity:0;pointer-events:none;transform:translateY(-8px);transition:opacity .2s ease,transform .2s ease}
      .menu.is-open{opacity:1;pointer-events:auto;transform:translateY(0)}
      .menu a{padding:.85rem 0;border-bottom:1px solid rgba(255,255,255,.08)}
      .menu a:last-child{border-bottom:0}
      .hotline{padding-left:.7rem}
